{
	"name": "n8n-nodes-n8flare",
	"version": "0.1.1",
	"description": "Compile, audit, and deploy n8n workflows directly to Cloudflare Workers on the edge with sub-20ms latency.",
	"license": "MIT",
	"homepage": "https://github.com/amaurygomes/n8n-nodes-n8flare#readme",
	"keywords": [
		"n8n-community-node-package",
		"cloudflare",
		"cloudflare-workers",
		"edge",
		"serverless",
		"n8flare",
		"automation"
	],
	"author": {
		"name": "Amaury Gomes Ibanez",
		"email": "amaury_mju@hotmail.com",
		"url": "https://github.com/amaurygomes"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amaurygomes/n8n-nodes-n8flare.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"main": "index.js",
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/N8FlareApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/N8Flare/N8Flare.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"prettier": "3.8.3",
		"release-it": "21.0.2",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
